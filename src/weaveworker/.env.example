AI_REQUEST_QUEUE=your_ai_request_queue_name
AI_CANCEL_EXCHANGE=your_ai_cancel_exchange_name
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_openai_model
OPENAI_TIMEOUT_MS=your_openai_timeout_in_milliseconds
OPENAI_MAX_OUTPUT_TOKENS=your_maximum_output_token_count
WEAVE_WORKER_ID=your_unique_worker_instance_id
WEAVE_WORKER_CONCURRENCY=your_worker_concurrency
WEAVE_WORKER_PROCESSING_LEASE_MS=your_processing_lease_in_milliseconds
WEAVE_WORKER_HEARTBEAT_MS=your_heartbeat_interval_in_milliseconds
RABBITMQ_RECONNECT_DELAY_MS=your_reconnect_delay_in_milliseconds
